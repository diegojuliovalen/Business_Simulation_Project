			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1747958319919</Id>
					<Name><![CDATA[calculateTotalCost]]></Name>
					<X>-290</X><Y>150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double totalMonthlyOpCost = 0;
double totalHoldingCost = 0;
double totalTourFixedCost = 0;
double totalTourVariableCost = 0;

// Sumar costos mensuales y holding de cada distribuidor
for (Distributor d : distributors) {
    totalMonthlyOpCost += d.monthlyOperationCost;

    double costMilk = d.milkInventory * d.holdingCostMilk;
    double costYogurt = d.yogurtInventory * d.holdingCostYogurt;
    double costCheese = d.cheeseInventory * d.holdingCostCheese;
    totalHoldingCost += costMilk + costYogurt + costCheese;
}

// Sumar costos de tours de cada camión
for (Truck t : trucks) {
    totalTourFixedCost += t.numberOfToursToday * 300;   // 300 RON fijo por tour
    totalTourVariableCost += t.distanceTravelledToday * 1.5; // 1.5 RON por km
}

double totalCost = totalMonthlyOpCost + totalHoldingCost + totalTourFixedCost + totalTourVariableCost;
this.totalCostAccumulated += totalCost;
traceln("=== Total Cost Report ===");
traceln("Monthly Operating Cost (all warehouses): RON " + totalMonthlyOpCost);
traceln("Holding Cost (all warehouses): RON " + totalHoldingCost);
traceln("Fixed Cost for Truck Tours: RON " + totalTourFixedCost);
traceln("Variable Cost for Truck Tours: RON " + totalTourVariableCost);
traceln("TOTAL COST: RON " + totalCost);
]]></Body>
				</Function>
			</Functions>
