			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1747920829057</Id>
					<Name><![CDATA[generateDailyDemand]]></Name>
					<X>230</X><Y>-20</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[traceln("Retailer " + location + " ejecutando generateDailyDemand en tiempo " + time());
traceln("milkMean=" + milkMean + ", yogurtMean=" + yogurtMean + ", cheeseMean=" + cheeseMean);

// Día actual (0=domingo, ..., 6=sábado)
int currentDay = (int)(time() / (24 * 3600)) % 7;

// Desviaciones estándar (15% del promedio)
double stdMilk = 0.15 * milkMean;
double stdYogurt = 0.15 * yogurtMean;
double stdCheese = 0.15 * cheeseMean;

// Simular distribución normal truncada manualmente para evitar negativos
double dailyMilkDemand = 0;
double dailyYogurtDemand = 0;
double dailyCheeseDemand = 0;

double sundayMilkDemand = 0;
double sundayYogurtDemand = 0;
double sundayCheeseDemand = 0;

int maxTries = 10;
for (int i = 0; i < maxTries; i++) {
    dailyMilkDemand = normal(milkMean, stdMilk);
    if (dailyMilkDemand >= 0) break;
}
for (int i = 0; i < maxTries; i++) {
    dailyYogurtDemand = normal(yogurtMean, stdYogurt);
    if (dailyYogurtDemand >= 0) break;
}
for (int i = 0; i < maxTries; i++) {
    dailyCheeseDemand = normal(cheeseMean, stdCheese);
    if (dailyCheeseDemand >= 0) break;
}

// Si es sábado (6), genera demanda extra para el domingo
if (currentDay == 6) {
    for (int i = 0; i < maxTries; i++) {
        sundayMilkDemand = normal(milkMean, stdMilk);
        if (sundayMilkDemand >= 0) break;
    }
    for (int i = 0; i < maxTries; i++) {
        sundayYogurtDemand = normal(yogurtMean, stdYogurt);
        if (sundayYogurtDemand >= 0) break;
    }
    for (int i = 0; i < maxTries; i++) {
        sundayCheeseDemand = normal(cheeseMean, stdCheese);
        if (sundayCheeseDemand >= 0) break;
    }
}

// Pedido final = demanda del día + demanda adicional del domingo (si aplica)
double orderMilk = Math.max(0, dailyMilkDemand + sundayMilkDemand);
double orderYogurt = Math.max(0, dailyYogurtDemand + sundayYogurtDemand);
double orderCheese = Math.max(0, dailyCheeseDemand + sundayCheeseDemand);

// Guardar pedido pendiente
this.pendingMilkOrder = orderMilk;
this.pendingYogurtOrder = orderYogurt;
this.pendingCheeseOrder = orderCheese;

traceln("Demanda generada hoy: Milk=" + dailyMilkDemand + ", Yogurt=" + dailyYogurtDemand + ", Cheese=" + dailyCheeseDemand);
traceln("Retailer " + location + " places order at day " + currentDay + ": Milk=" + orderMilk + ", Yogurt=" + orderYogurt + ", Cheese=" + orderCheese);
]]></Body>
				</Function>
			</Functions>
