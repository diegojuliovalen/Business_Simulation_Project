					<IconOffset>35.0</IconOffset>
					<Properties Source="1678954921912" Target="1744281032274" Trigger="arrival">
						<Action><![CDATA[orderBeingDelivered.timeDelivered = time();
orderBeingDelivered.leadTime = orderBeingDelivered.timeDelivered - orderBeingDelivered.timeIssued;

main.add_orders(orderBeingDelivered.amount, orderBeingDelivered.retailer);
main.orders(main.orders.size()-1).timeIssued = orderBeingDelivered.timeIssued;
main.orders(main.orders.size()-1).timeDelivered = orderBeingDelivered.timeDelivered;
main.orders(main.orders.size()-1).leadTime = orderBeingDelivered.leadTime;
main.orders(main.orders.size()-1).delayed = orderBeingDelivered.delayed;

main.collectionOfOrders.add(orderBeingDelivered);
double dx = getX() - lastX;
double dy = getY() - lastY;
distanceTravelledToday += Math.sqrt(dx*dx + dy*dy);

// Actualizamos la última posición
lastX = getX();
lastY = getY();
]]></Action>
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
