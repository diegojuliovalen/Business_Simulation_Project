	<Id>1678952554499</Id>
	<Name><![CDATA[FINALEXAMMODELANYLOGIC]]></Name>
	<EngineVersion>6</EngineVersion>
	<JavaPackageName><![CDATA[supply_chain]]></JavaPackageName>
	<ModelTimeUnit><![CDATA[Hour]]></ModelTimeUnit>
	<Folders>
	</Folders>
	<ActiveObjectClasses>
		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1678952554506</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[init_no_trucks = (int) sum(distributors, d -> d.nTrucks);
traceln("Initial number of trucks:"+init_no_trucks);
for (Distributor d: distributors)
	{
	d.percentage_of_trucks = (d.nTrucks + 0.0)/init_no_trucks;
	traceln("Percentage of trucks in "+ d.location+" is "+d.percentage_of_trucks);
	int distributor_no_of_trucks;
	distributor_no_of_trucks = (int) Math.round(d.percentage_of_trucks * total_no_trucks);
	for (int i=1 ; i <= distributor_no_of_trucks ; i++)
		{
		add_trucks(d.location);
		}
	}

for (Distributor d : distributors) {
    traceln(d.location + " ready to place orders.");
}


//#EXPANDIR LA CAPACIDAD 
int expandedCount = 0;
while (expandedCount < 2) {
    int index = uniform_discr(0, distributors.size() - 1);
    Distributor d = distributors.get(index);
    if (!d.isExpanded) {  // Asegúrate que tienes esta variable booleana en Distributor
        // Expande capacidades
        d.milkCapacity *= 1.4;
        d.yogurtCapacity *= 1.4;
        d.cheeseCapacity *= 1.4;

        // Aumenta costo operativo mensual
        d.monthlyOperationCost *= 1.25;

        d.isExpanded = true;
        traceln(d.location + " expanded (random selection)");
        expandedCount++;
    }
}


//#ASIGNAMOS RETAILERS
for (Retailer r : retailers) {
    if (r.assignedDistributor != null) {
        for (Distributor d : distributors) {
            if (r.assignedDistributor.equals(d.location)) {
                r.correspondingDistributor = d;
                break;
            }
        }
    }
}


// Supongo que la tabla en Main se llama retailersTable
