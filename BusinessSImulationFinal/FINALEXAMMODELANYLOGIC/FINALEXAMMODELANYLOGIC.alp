			<Events>
				<Event>
					<Id>1747919758576</Id>
					<Name><![CDATA[receiveDelivery]]></Name>
					<X>410</X><Y>140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<Id>1747919758574</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1648108800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[9]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Añade los pedidos pendientes al inventario actual
milkInventory += pendingMilk;
yogurtInventory += pendingYogurt;
cheeseInventory += pendingCheese;

// Imprime la recepción para debug
traceln(location + " received delivery at time " + time() + ": Milk=" + pendingMilk +
        ", Yogurt=" + pendingYogurt + ", Cheese=" + pendingCheese);

// Resetea los pedidos pendientes a cero porque ya fueron entregados
pendingMilk = 0;
pendingYogurt = 0;
pendingCheese = 0;

]]></Action>
				</Event>
				<Event>
					<Id>1747919758583</Id>
					<Name><![CDATA[spoilageEvent]]></Name>
					<X>410</X><Y>290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<Id>1747919758581</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1747728000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[20]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[24]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[double milkSpoilageRate = uniform(0.01, 0.02);
double yogurtSpoilageRate = uniform(0.005, 0.015);
double cheeseSpoilageRate = uniform(0.002, 0.008);

double spoiledMilk = milkInventory * milkSpoilageRate;
double spoiledYogurt = yogurtInventory * yogurtSpoilageRate;
double spoiledCheese = cheeseInventory * cheeseSpoilageRate;

// Restamos del inventario
milkInventory -= spoiledMilk;
yogurtInventory -= spoiledYogurt;
cheeseInventory -= spoiledCheese;
this.totalspoilageaccumulated += spoiledMilk+spoiledYogurt+spoiledCheese;

// Imprimimos lo que se perdió
traceln("Spoilage at " + location + " on day " + time()/24 + ": Milk=" + spoiledMilk +
        ", Yogurt=" + spoiledYogurt + ", Cheese=" + spoiledCheese);

// Aseguramos que el inventario no sea negativo
milkInventory = Math.max(0, milkInventory);
yogurtInventory = Math.max(0, yogurtInventory);
cheeseInventory = Math.max(0, cheeseInventory);
]]></Action>
					<Logging>false</Logging>
				</Event>
				<Event>
					<Id>1747919758589</Id>
					<Name><![CDATA[calculateDailyHoldingCost]]></Name>
					<X>410</X><Y>410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<Id>1747919758587</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1747728000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[20]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[24]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[double costMilk = milkInventory * holdingCostMilk;
double costYogurt = yogurtInventory * holdingCostYogurt;
double costCheese = cheeseInventory * holdingCostCheese;

double totalHoldingCost = costMilk + costYogurt + costCheese;

traceln("Holding cost at " + location + " at time " + time() + ": RON " + totalHoldingCost +
        " (Milk=" + costMilk + ", Yogurt=" + costYogurt + ", Cheese=" + costCheese + ")");
        
]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1747919758546</Id>
					<Name><![CDATA[placeOrder]]></Name>
					<X>250</X><Y>310</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Imprime el stock antes de ordenar
traceln("Stock before ordering at " + location + " at time " + time() + ": Milk=" + milkInventory +
        ", Yogurt=" + yogurtInventory + ", Cheese=" + cheeseInventory);

// Calcula la cantidad a ordenar para llenar la capacidad restante
double orderMilk = milkCapacity - milkInventory;
double orderYogurt = yogurtCapacity - yogurtInventory;
double orderCheese = cheeseCapacity - cheeseInventory;

// Evita pedidos negativos
orderMilk = Math.max(orderMilk, 0);
orderYogurt = Math.max(orderYogurt, 0);
orderCheese = Math.max(orderCheese, 0);

// Guarda el pedido pendiente para la entrega futura
pendingMilk = orderMilk;
pendingYogurt = orderYogurt;
pendingCheese = orderCheese;

// Imprime la orden realizada
traceln(location + " placed order at time " + time() + ": Milk=" + orderMilk +
        ", Yogurt=" + orderYogurt + ", Cheese=" + orderCheese);

// ACTUALIZACION PARA INCLUIR COSTOS FIJOS
double costMilk = (orderMilk > 0) ? fixedOrderCostMilk : 0;
double costYogurt = (orderYogurt > 0) ? fixedOrderCostYogurt : 0;
double costCheese = (orderCheese > 0) ? fixedOrderCostCheese : 0;

// Suma total del costo fijo por esta orden
double totalFixedOrderingCost = costMilk + costYogurt + costCheese;

// Guarda o acumula el costo total (podrías tener una variable en el agente o en Main para acumular costos)
totalOrderingCost += totalFixedOrderingCost;  // Define esta variable antes

// Imprime el costo fijo de la orden
traceln(location + " fixed ordering cost this order: " + totalFixedOrderingCost);

// Nota: Ya NO se programa ni reinicia receiveDelivery aquí.
// receiveDelivery.restart(delaySeconds); // <-- Esta línea fue eliminada
]]></Body>
				</Function>
			</Functions>
